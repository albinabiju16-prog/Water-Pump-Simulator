    {"id":"read_ir","type":"modbus-read","z":"tab1","name":"Read Sensors (IR 0-5)","topic":"","showStatusActivities":true,"logIOActivities":false,"showErrors":true,"showWarnings":true,"unitid":"1","dataType":"InputRegister","adr":"0","quantity":"6","rate":"1","rateUnit":"s","delayOnStart":false,"startDelayTime":"","server":"mb_client","useIOFile":false,"ioFile":"","useIOForPayload":false,"emptyMsgOnFail":false,"x":140,"y":120,"wires":[["dbg_ir","fn_ir"],[]]},
    {"id":"dbg_ir","type":"debug","z":"tab1","name":"Live Registers","active":true,"tosidebar":true,"console":false,"tostatus":false,"complete":"payload","targetType":"msg","x":380,"y":60,"wires":[]},
    {"id":"fn_ir","type":"function","z":"tab1","name":"Scale Values","func":"let d = msg.payload;\nif (!Array.isArray(d) || d.length < 6) return null;\nlet faultText = 'HEALTHY (No Fault)';\nif (d[5] === 1) faultText = 'ALARM: LOW PRESSURE FAULT!';\nif (d[5] === 2) faultText = 'ALARM: HIGH TEMP FAULT (>80C)!';\nlet toastMsg = (d[5] !== 0) ? {payload: faultText} : null;\nreturn [\n  {payload: (d[0] / 10).toFixed(1)},\n  {payload: (d[1] / 10).toFixed(1) + ' m³/h'},\n  {payload: (d[2] / 100).toFixed(2) + ' bar'},\n  {payload: d[3] + ' RPM'},\n  {payload: (d[4] / 10).toFixed(1) + ' °C'},\n  {payload: faultText},\n  toastMsg\n];","outputs":7,"noerr":0,"x":370,"y":140,"wires":[["ui_tank"],["ui_flow"],["ui_press"],["ui_rpm"],["ui_temp"],["ui_fault"],["ui_toast"]]},
    {"id":"read_di","type":"modbus-read","z":"tab1","name":"Read Status (DI 0-1)","topic":"","showStatusActivities":true,"logIOActivities":false,"showErrors":true,"showWarnings":true,"unitid":"1","dataType":"Input","adr":"0","quantity":"2","rate":"1","rateUnit":"s","delayOnStart":false,"startDelayTime":"","server":"mb_client","useIOFile":false,"ioFile":"","useIOForPayload":false,"emptyMsgOnFail":false,"x":140,"y":280,"wires":[["fn_di"],[]]},
    {"id":"fn_di","type":"function","z":"tab1","name":"Decode State","func":"let d = msg.payload;\nif (!Array.isArray(d) || d.length < 2) return null;\nlet state = 'STOPPED';\nif (d[1]) state = 'FAULT';\nelse if (d[0]) state = 'RUNNING';\nreturn {payload: state};","outputs":1,"noerr":0,"x":370,"y":280,"wires":[["ui_state"]]},
    {"id":"st_watch","type":"status","z":"tab1","name":"Connection Monitor","scope":["read_ir"],"x":130,"y":360,"wires":[["fn_conn"]]},
    {"id":"fn_conn","type":"function","z":"tab1","name":"Check Link","func":"let txt = (msg.status && msg.status.text) ? msg.status.text : '';\nlet ok = txt.includes('active') || txt.includes('connected');\nreturn {payload: ok ? 'CONNECTED (Port 5020)' : 'DISCONNECTED (Simulator Offline)'};","outputs":1,"noerr":0,"x":370,"y":360,"wires":[["ui_conn"]]},
